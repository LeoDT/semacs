=== focused
KEY   key="a" key_char=None ctrl=true alt=false shift=false super=false pref=false
RESOLVE seq="C-a" pending="" -> Execute("move-beginning-of-line")
CMD   move-beginning-of-line
KEY   key="f" key_char=None ctrl=true alt=false shift=false super=false pref=false
RESOLVE seq="C-f" pending="" -> Execute("forward-char")
CMD   forward-char
KEY   key="f" key_char=None ctrl=true alt=false shift=false super=false pref=false
RESOLVE seq="C-f" pending="" -> Execute("forward-char")
CMD   forward-char
KEY   key="space" key_char=None ctrl=true alt=false shift=false super=false pref=false
RESOLVE seq="C-space" pending="" -> Execute("set-mark-command")
CMD   set-mark-command
ECHO  Mark set
KEY   key="a" key_char=None ctrl=true alt=false shift=false super=false pref=false
RESOLVE seq="C-a" pending="" -> Execute("move-beginning-of-line")
CMD   move-beginning-of-line
KEY   key="x" key_char=Some("x") ctrl=false alt=false shift=false super=false pref=false
RESOLVE seq="x" pending="" -> SelfInsert
TARGET[buffer] replace_text_in_range range_utf16=None bytes=0..0 text="x"
CHANGE text="xabcdef" cursor=1 sel=1..1
KEY   key="s" key_char=None ctrl=true alt=false shift=true super=false pref=false
RESOLVE seq="C-S-s" pending="" -> Execute("spike-dump")
CMD   spike-dump
DUMP  text="xabcdef" cursor=1 sel=1..1 mark=Some(3) active=false echo="Mark set" pending="" ring=0 session=Buffer mini="" undo=1 redo=0
DUMP2 dirty=true mini_undo=0/0
KEY   key="u" key_char=None ctrl=true alt=false shift=true super=false pref=false
RESOLVE seq="C-S-u" pending="" -> Execute("spike-undo")
CMD   spike-undo
REPLAY undo 0..1 <- ""
TARGET[buffer] replace_text_in_range range_utf16=Some(0..1) bytes=0..1 text=""
OWNUNDO text="xabcdef" cursor=1 sel=1..1 -> text="abcdef" cursor=0 sel=0..0
CHANGE text="abcdef" cursor=0 sel=0..0
KEY   key="s" key_char=None ctrl=true alt=false shift=true super=false pref=false
RESOLVE seq="C-S-s" pending="" -> Execute("spike-dump")
CMD   spike-dump
DUMP  text="abcdef" cursor=0 sel=0..0 mark=Some(2) active=false echo="Mark set" pending="" ring=0 session=Buffer mini="" undo=0 redo=1
DUMP2 dirty=false mini_undo=0/0
KEY   key="r" key_char=None ctrl=true alt=false shift=true super=false pref=false
RESOLVE seq="C-S-r" pending="" -> Execute("spike-redo")
CMD   spike-redo
REPLAY redo 0..0 <- "x"
TARGET[buffer] replace_text_in_range range_utf16=Some(0..0) bytes=0..0 text="x"
CHANGE text="xabcdef" cursor=0 sel=0..0
KEY   key="s" key_char=None ctrl=true alt=false shift=true super=false pref=false
RESOLVE seq="C-S-s" pending="" -> Execute("spike-dump")
CMD   spike-dump
DUMP  text="xabcdef" cursor=0 sel=0..0 mark=Some(3) active=false echo="Mark set" pending="" ring=0 session=Buffer mini="" undo=1 redo=0
DUMP2 dirty=true mini_undo=0/0
