=== focused
KEY   key="a" key_char=None ctrl=true alt=false shift=false super=false pref=false
RESOLVE seq="C-a" pending="" -> Execute("move-beginning-of-line")
CMD   move-beginning-of-line
KEY   key="k" key_char=None ctrl=true alt=false shift=false super=false pref=false
RESOLVE seq="C-k" pending="" -> Execute("kill-line")
CMD   kill-line
TARGET[buffer] replace_text_in_range range_utf16=Some(0..2) bytes=0..2 text=""
CHANGE text="" cursor=0 sel=0..0
KEY   key="y" key_char=None ctrl=true alt=false shift=false super=false pref=false
RESOLVE seq="C-y" pending="" -> Execute("yank")
CMD   yank
TARGET[buffer] replace_text_in_range range_utf16=Some(0..0) bytes=0..0 text="ab"
ECHO  Mark set
CHANGE text="ab" cursor=2 sel=2..2
KEY   key="s" key_char=None ctrl=true alt=false shift=true super=false pref=false
RESOLVE seq="C-S-s" pending="" -> Execute("spike-dump")
CMD   spike-dump
DUMP  text="ab" cursor=2 sel=2..2 mark=Some(0) active=false echo="Mark set" pending="" ring=1 session=Buffer mini="" undo=2 redo=0
DUMP2 dirty=true mini_undo=0/0
KEY   key="/" key_char=None ctrl=true alt=false shift=false super=false pref=false
RESOLVE seq="C-/" pending="" -> Execute("undo")
CMD   undo
REPLAY undo 0..2 <- ""
TARGET[buffer] replace_text_in_range range_utf16=Some(0..2) bytes=0..2 text=""
OWNUNDO text="ab" cursor=2 sel=2..2 -> text="" cursor=0 sel=0..0
CHANGE text="" cursor=0 sel=0..0
KEY   key="s" key_char=None ctrl=true alt=false shift=true super=false pref=false
RESOLVE seq="C-S-s" pending="" -> Execute("spike-dump")
CMD   spike-dump
DUMP  text="" cursor=0 sel=0..0 mark=Some(0) active=false echo="Mark set" pending="" ring=1 session=Buffer mini="" undo=1 redo=1
DUMP2 dirty=true mini_undo=0/0
KEY   key="/" key_char=None ctrl=true alt=false shift=false super=false pref=false
RESOLVE seq="C-/" pending="" -> Execute("undo")
CMD   undo
REPLAY undo 0..0 <- "ab"
TARGET[buffer] replace_text_in_range range_utf16=Some(0..0) bytes=0..0 text="ab"
OWNUNDO text="" cursor=0 sel=0..0 -> text="ab" cursor=0 sel=0..0
CHANGE text="ab" cursor=0 sel=0..0
KEY   key="s" key_char=None ctrl=true alt=false shift=true super=false pref=false
RESOLVE seq="C-S-s" pending="" -> Execute("spike-dump")
CMD   spike-dump
DUMP  text="ab" cursor=0 sel=0..0 mark=Some(0) active=false echo="Mark set" pending="" ring=1 session=Buffer mini="" undo=0 redo=2
DUMP2 dirty=false mini_undo=0/0
