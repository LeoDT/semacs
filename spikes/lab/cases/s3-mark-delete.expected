=== focused
KEY   key="a" key_char=None ctrl=true alt=false shift=false super=false pref=false
RESOLVE seq="C-a" pending="" -> Execute("move-beginning-of-line")
CMD   move-beginning-of-line
KEY   key="f" key_char=None ctrl=true alt=false shift=false super=false pref=false
