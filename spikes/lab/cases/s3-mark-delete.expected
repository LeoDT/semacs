RESOLVE seq="C-a" pending="" -> Execute("move-beginning-of-line")
CMD   move-beginning-of-line
KEY   key="k" key_char=None ctrl=true alt=false shift=false super=false pref=false
RESOLVE seq="C-k" pending="" -> Execute("kill-line")
CMD   kill-line
TARGET[buffer] replace_text_in_range range_utf16=Some(0..6) bytes=0..6 text=""
CHANGE text="" cursor=0 sel=0..0
KEY   key="s" key_char=None ctrl=true alt=false shift=true super=false pref=false
RESOLVE seq="C-S-s" pending="" -> Execute("spike-dump")
CMD   spike-dump
DUMP  text="" cursor=0 sel=0..0 mark=Some(0) active=false echo="Mark set" pending="" ring=1 session=Buffer mini="" undo=1 redo=0
DUMP2 dirty=true mini_undo=0/0
KEY   key="u" key_char=None ctrl=true alt=false shift=true super=false pref=false
RESOLVE seq="C-S-u" pending="" -> Execute("spike-undo")
CMD   spike-undo
REPLAY undo 0..0 <- "abcdef"
TARGET[buffer] replace_text_in_range range_utf16=Some(0..0) bytes=0..0 text="abcdef"
OWNUNDO text="" cursor=0 sel=0..0 -> text="abcdef" cursor=0 sel=0..0
