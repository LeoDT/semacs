=== focused
KEY   key="a" key_char=None ctrl=true alt=false shift=false super=false pref=false
RESOLVE seq="C-a" pending="" -> Execute("move-beginning-of-line")
CMD   move-beginning-of-line
KEY   key="k" key_char=None ctrl=true alt=false shift=false super=false pref=false
RESOLVE seq="C-k" pending="" -> Execute("kill-line")
CMD   kill-line
TARGET[buffer] replace_text_in_range range_utf16=Some(3..5) bytes=3..5 text=""
CHANGE text="ab\n" cursor=3 sel=3..3
KEY   key="k" key_char=None ctrl=true alt=false shift=false super=false pref=false
RESOLVE seq="C-k" pending="" -> Execute("kill-line")
CMD   kill-line
ECHO  End of buffer
KEY   key="s" key_char=None ctrl=true alt=false shift=true super=false pref=false
RESOLVE seq="C-S-s" pending="" -> Execute("spike-dump")
CMD   spike-dump
DUMP  text="ab\n" cursor=3 sel=3..3 mark=None active=false echo="End of buffer" pending="" ring=1 session=Buffer mini="" undo=1 redo=0
DUMP2 dirty=true mini_undo=0/0
KEY   key="/" key_char=None ctrl=true alt=false shift=false super=false pref=false
RESOLVE seq="C-/" pending="" -> Execute("undo")
CMD   undo
REPLAY undo 3..3 <- "cd"
TARGET[buffer] replace_text_in_range range_utf16=Some(3..3) bytes=3..3 text="cd"
OWNUNDO text="ab\n" cursor=3 sel=3..3 -> text="ab\ncd" cursor=3 sel=3..3
CHANGE text="ab\ncd" cursor=3 sel=3..3
KEY   key="s" key_char=None ctrl=true alt=false shift=true super=false pref=false
RESOLVE seq="C-S-s" pending="" -> Execute("spike-dump")
CMD   spike-dump
DUMP  text="ab\ncd" cursor=3 sel=3..3 mark=None active=false echo="End of buffer" pending="" ring=1 session=Buffer mini="" undo=0 redo=1
DUMP2 dirty=false mini_undo=0/0
KEY   key="/" key_char=None ctrl=true alt=false shift=false super=false pref=false
RESOLVE seq="C-/" pending="" -> Execute("undo")
CMD   undo
ECHO  No further undo information
KEY   key="s" key_char=None ctrl=true alt=false shift=true super=false pref=false
RESOLVE seq="C-S-s" pending="" -> Execute("spike-dump")
CMD   spike-dump
DUMP  text="ab\ncd" cursor=3 sel=3..3 mark=None active=false echo="No further undo information" pending="" ring=1 session=Buffer mini="" undo=0 redo=1
DUMP2 dirty=false mini_undo=0/0
