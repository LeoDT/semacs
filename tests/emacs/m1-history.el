;;; m1-history.el --- Explicit-boundary history reference -*- lexical-binding: t; -*-

(require 'ert)

(defmacro semacs-with-history-reference (text &rest body)
  (declare (indent 1))
  `(with-temp-buffer
     (fundamental-mode)
     (transient-mark-mode 1)
     (insert ,text)
     (goto-char (point-min))
     (set-buffer-modified-p nil)
     (buffer-enable-undo)
     (setq buffer-undo-list nil)
     (let ((last-command nil)
           (this-command nil)
           (pending-undo-list nil))
       (should (equal emacs-version "31.1"))
       ,@body)))

(defun semacs-history-reference-undo ()
  (undo-boundary)
  (setq last-command nil)
  (deactivate-mark)
  (let ((current-prefix-arg nil)) (call-interactively #'undo-only))
  (setq last-command 'undo))

(ert-deftest semacs-history-insert-and-redo-point ()
  (semacs-with-history-reference "tail"
    (insert "中🙂é")
    (semacs-history-reference-undo)
    (should (equal (buffer-string) "tail"))
    (should (= (point) 1))
    (should-not (buffer-modified-p))
    (undo-redo 1)
    (should (equal (buffer-string) "中🙂étail"))
    (should (= (point) 1))
    (should (buffer-modified-p))))

(ert-deftest semacs-history-marker-deletion-and-redo ()
  (semacs-with-history-reference "abcdef"
    (set-mark 4)
    (delete-region 1 4)
    (should (= (mark) 1))
    (semacs-history-reference-undo)
    (should (equal (buffer-string) "abcdef"))
    (should (= (mark) 4))
    (undo-redo 1)
    (should (equal (buffer-string) "def"))
    (should (= (mark) 1))))

(ert-deftest semacs-history-moved-marker-does-not-restore ()
  (semacs-with-history-reference "abcdef"
    (set-mark 3)
    (delete-region 1 4)
    (set-mark 4)
    (semacs-history-reference-undo)
    (should (equal (buffer-string) "abcdef"))
    (should (= (mark) 7))))

(ert-deftest semacs-history-marker-created-inside-inserted-text ()
  (semacs-with-history-reference ""
    (insert "中🙂Z")
    (set-mark 3)
    (semacs-history-reference-undo)
    (should (= (mark) 1))
    (undo-redo 1)
    (should (equal (buffer-string) "中🙂Z"))
    (should (= (mark) 3))))

(ert-deftest semacs-history-save-and-fixed-crossing ()
  (semacs-with-history-reference ""
    (insert "abc")
    (undo-boundary)
    (set-buffer-modified-p nil)
    (insert "d")
    (semacs-history-reference-undo)
    (should (equal (buffer-string) "abc"))
    (should-not (buffer-modified-p))
    (undo-only 1)
    (should (equal (buffer-string) ""))
    (should-not (buffer-modified-p))
    (insert "X")
    (should (buffer-modified-p))))

(ert-deftest semacs-history-empty-and-readonly ()
  (semacs-with-history-reference ""
    (should-error (undo-only 1) :type 'user-error)
    (insert "abc")
    (setq buffer-read-only t)
    (should-error (semacs-history-reference-undo) :type 'buffer-read-only)
    (should (equal (buffer-string) "abc"))
    (setq buffer-read-only nil)
    (semacs-history-reference-undo)
    (should (equal (buffer-string) ""))))
