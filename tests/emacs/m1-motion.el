;;; m1-motion.el --- M1 motion reference -*- lexical-binding: t; -*-

;; Direct function calls, not command-loop or GUI evidence.
(require 'ert)

(defun semacs-motion-byte-point ()
  (string-bytes (buffer-substring-no-properties (point-min) (point))))

(ert-deftest reference/m1-word-motion ()
  (should (equal emacs-version "31.1"))
  (with-temp-buffer
    (fundamental-mode)
    (insert "one_two foo-bar 中中文 last!\n")
    (goto-char (point-min))
    (dolist (expected '(3 7 11 15 25 30 32 32))
      (forward-word)
      (should (= (semacs-motion-byte-point) expected)))
    (dolist (expected '(26 16 12 8 4 0 0))
      (backward-word)
      (should (= (semacs-motion-byte-point) expected)))))

(ert-deftest reference/m1-logical-line-goal-and-boundary ()
  (should (equal emacs-version "31.1"))
  (with-temp-buffer
    (fundamental-mode)
    (insert "abc\nx\nabcdef")
    (goto-char 3)
    (let ((line-move-visual nil)
          (next-line-add-newlines nil)
          (goal-column nil)
          (temporary-goal-column nil)
          (last-command nil))
      (next-line)
      (setq last-command 'next-line)
      (should (= (semacs-motion-byte-point) 5))
      (next-line)
      (should (= (semacs-motion-byte-point) 8))
      (should-error (next-line) :type 'end-of-buffer)
      (should (= (semacs-motion-byte-point) 12))
      (previous-line)
      (setq last-command 'previous-line)
      (previous-line)
      (should (= (semacs-motion-byte-point) 2))
      (should-error (previous-line) :type 'beginning-of-buffer)
      (should (= (semacs-motion-byte-point) 0)))))

(ert-deftest reference/m1-line-display-columns ()
  (should (equal emacs-version "31.1"))
  (dolist (case '(("中éx\nabcdef" 4 11)
                  ("1234\n\tfoo" 5 6)
                  ("a\n中x" 2 5)
                  ("a\néx" 2 3)
                  ("\ńx" 1 1)
                  ("\tfoo\n1234567890" 2 13)))
    (with-temp-buffer
      (fundamental-mode)
      (insert (nth 0 case))
      (goto-char (nth 1 case))
      (let ((tab-width 8)
            (line-move-visual nil)
            (next-line-add-newlines nil)
            (goal-column nil)
            (last-command nil))
        (next-line)
        (should (= (semacs-motion-byte-point) (nth 2 case)))))))

(ert-deftest reference/m1-buffer-jump-mark ()
  (should (equal emacs-version "31.1"))
  (dolist (active '(nil t))
    (with-temp-buffer
      (fundamental-mode)
      (transient-mark-mode 1)
      (insert "abc")
      (goto-char 3)
      (set-mark 1)
      (setq mark-active active)
      (beginning-of-buffer)
      (should (= (point) 1))
      (should (= (mark) (if active 1 3)))
      (should (eq mark-active active))
      (end-of-buffer)
      (should (= (point) 4))
      (should (= (mark) 1))
      (should (eq mark-active active)))))

(ert-deftest reference/m1-first-page ()
  (should (equal emacs-version "31.1"))
  (save-window-excursion
    (with-temp-buffer
      (fundamental-mode)
      (dotimes (_ 100) (insert "abcdef\n"))
      (set-window-buffer (selected-window) (current-buffer))
      (goto-char (point-min))
      (set-window-start nil (point-min))
      (let ((next-screen-context-lines 2)
            (scroll-preserve-screen-position nil)
            (scroll-margin 0))
        (scroll-up-command)
        (should (= (1- (line-number-at-pos))
                   (- (window-body-height) next-screen-context-lines)))
        (should (= (point) (window-start)))
        (should (= (current-column) 0))))))

(ert-deftest reference/m1-word-syntax-differences ()
  (should (equal emacs-version "31.1"))
  (with-temp-buffer
    (fundamental-mode)
    (insert "éclair")
    (goto-char (point-min))
    (forward-word)
    ;; Emacs includes combining marks and treats this emoji as its own word.
    (should (= (semacs-motion-byte-point) 8)))
  (with-temp-buffer
    (fundamental-mode)
    (insert "🙂last")
    (goto-char (point-min))
    (forward-word)
    (should (= (semacs-motion-byte-point) 4))))
