;;; m1-kill.el --- M1 kill and yank reference -*- lexical-binding: t; -*-

;; Direct function calls; command-loop collection is separate.
(require 'ert)

(defmacro semacs-with-kill-reference (text &rest body)
  (declare (indent 1))
  `(with-temp-buffer
     (fundamental-mode)
     (transient-mark-mode 1)
     (insert ,text)
     (goto-char (point-min))
     (set-buffer-modified-p nil)
     (let ((kill-ring nil)
           (kill-ring-yank-pointer nil)
           (interprogram-cut-function nil)
           (interprogram-paste-function nil)
           (kill-whole-line nil)
           (show-trailing-whitespace nil)
           (kill-read-only-ok nil)
           (last-command nil)
           (this-command nil)
           (deactivate-mark nil))
       (should (equal emacs-version "31.1"))
       ,@body)))

(defun semacs-kill-reference-command (command)
  (setq this-command command deactivate-mark nil)
  (unwind-protect
      (call-interactively command)
    (setq last-command this-command)
    ;; Apply the transient mark effect normally performed by the command loop.
    (when deactivate-mark (deactivate-mark))))

(ert-deftest reference/m1-kill-line-ranges ()
  (dolist (case '(("abc\ndef" 1 "\ndef" "abc")
                  ("abc\ndef" 4 "abcdef" "\n")
                  ("  \t\ndef" 1 "def" "  \t\n")
                  ("abc  \ndef" 4 "abcdef" "  \n")
                  ("abc   " 4 "abc" "   ")
                  ("\n\ndef" 1 "\ndef" "\n")
                  ("中🙂\ntail" 2 "中\ntail" "🙂")
                  ("abc \ndef" 4 "abc\ndef" " ")))
    (semacs-with-kill-reference (nth 0 case)
      (goto-char (nth 1 case))
      (semacs-kill-reference-command 'kill-line)
      (should (equal (buffer-string) (nth 2 case)))
      (should (equal kill-ring (list (nth 3 case)))))))

(ert-deftest reference/m1-consecutive-kill-and-eob ()
  (semacs-with-kill-reference "abc\ndef"
    (semacs-kill-reference-command 'kill-line)
    (semacs-kill-reference-command 'kill-line)
    (should (equal kill-ring '("abc\n")))
    (semacs-kill-reference-command 'kill-line)
    (should (equal kill-ring '("abc\ndef")))
    (should-error (semacs-kill-reference-command 'kill-line) :type 'end-of-buffer)
    (should (equal kill-ring '("abc\ndef")))))

(ert-deftest reference/m1-copy-direction-and-chain ()
  (dolist (positions '((1 3 "oldab") (3 1 "abold")))
    (semacs-with-kill-reference "abcd"
      (goto-char (nth 1 positions))
      (set-mark (nth 0 positions))
      (setq kill-ring (list "old") last-command 'kill-region)
      (semacs-kill-reference-command 'kill-ring-save)
      (should (equal kill-ring (list (nth 2 positions))))
      (should-not mark-active)
      (should-not (buffer-modified-p))
      (semacs-kill-reference-command 'kill-ring-save)
      (should (equal kill-ring (list "ab" (nth 2 positions))))
      (semacs-kill-reference-command 'kill-region)
      (should (equal (buffer-string) "cd"))
      (should (equal kill-ring (list "ab" "ab" (nth 2 positions)))))))

(ert-deftest reference/m1-empty-and-inactive-regions ()
  (dolist (command '(kill-region kill-ring-save))
    (dolist (readonly '(nil t))
      (semacs-with-kill-reference "abc"
        (goto-char 2)
        (set-mark 2)
        (setq buffer-read-only readonly)
        (semacs-kill-reference-command command)
        (should (equal kill-ring '("")))
        (should-not (buffer-modified-p))
        (should-not mark-active)))
    (semacs-with-kill-reference "abcdef"
      (goto-char 2)
      (set-mark 5)
      (deactivate-mark)
      (semacs-kill-reference-command command)
      (should (equal kill-ring '("bcd")))
      (should-not mark-active))))

(ert-deftest reference/m1-readonly-kill-copies ()
  (dolist (command '(kill-region kill-ring-save kill-line))
    (semacs-with-kill-reference "abcdef\nx"
      (goto-char 2)
      (set-mark 5)
      (setq buffer-read-only t)
      (if (eq command 'kill-ring-save)
          (semacs-kill-reference-command command)
        (should-error (semacs-kill-reference-command command) :type 'buffer-read-only))
      (should (equal (buffer-string) "abcdef\nx"))
      (should (equal kill-ring (list (if (eq command 'kill-line) "bcdef" "bcd"))))
      (should (= (point) (if (eq command 'kill-line) 7 2)))
      (should (= (mark) 5))
      (should-not mark-active)
      (should-not (buffer-modified-p)))))

(ert-deftest reference/m1-yank-region-and-empty-ring ()
  (semacs-with-kill-reference "abcdef"
    (goto-char 5)
    (set-mark 2)
    (setq kill-ring (list "中🙂"))
    (semacs-kill-reference-command 'yank)
    (should (equal (buffer-string) "abcd中🙂ef"))
    (should (= (point) 7))
    (should (= (mark) 5))
    (should-not mark-active))
  (semacs-with-kill-reference "abc"
    (goto-char 2)
    (set-mark 3)
    (setq buffer-read-only t)
    (should-error (semacs-kill-reference-command 'yank) :type 'buffer-read-only)
    (should (= (mark) 3))
    (should mark-active)
    (setq buffer-read-only nil)
    (should-error (semacs-kill-reference-command 'yank))
    (should (= (mark) 2))
    (should mark-active)
    (setq kill-ring (list ""))
    (semacs-kill-reference-command 'yank)
    (should mark-active)
    (should-not (buffer-modified-p))))

(ert-deftest reference/m1-kill-ring-capacity-and-duplicates ()
  (semacs-with-kill-reference "abc"
    (should (= kill-ring-max 120))
    (set-mark 4)
    (dotimes (_ 125)
      (semacs-kill-reference-command 'kill-ring-save))
    (should (= (length kill-ring) 120))
    (should (equal (delete-dups (copy-sequence kill-ring)) '("abc")))))
