;;; m1-fields.el --- Protected prefix and field reference -*- lexical-binding: t; -*-

(require 'ert)

(defmacro semacs-with-field-reference (prompt initial &rest body)
  (declare (indent 2))
  `(with-temp-buffer
     (fundamental-mode)
     (transient-mark-mode 1)
     (insert (propertize ,prompt
                         'read-only t
                         'field 'minibuffer-prompt
                         'front-sticky t
                         'rear-nonsticky t))
     (insert ,initial)
     (buffer-enable-undo)
     (setq buffer-undo-list nil)
     (let ((kill-ring nil)
           (kill-ring-yank-pointer nil)
           (interprogram-cut-function nil)
           (interprogram-paste-function nil)
           (kill-read-only-ok nil)
           (copy-region-blink-delay 0)
           (last-command nil)
           (this-command nil))
       (should (equal emacs-version "31.1"))
       ,@body)))

(ert-deftest semacs-field-motion-is-not-readonly-protection ()
  (semacs-with-field-reference "Input: " "abc"
    (move-beginning-of-line 1)
    (should (= (point) 8))
    (backward-char)
    (should (= (point) 7))
    (move-end-of-line 1)
    (should (= (point) 11))
    (move-beginning-of-line 1)
    (should (= (point) 8))
    (backward-char)
    (move-beginning-of-line 1)
    (should (= (point) 1))
    (move-end-of-line 1)
    (should (= (point) 11))
    (let ((inhibit-field-text-motion t))
      (move-beginning-of-line 1))
    (should (= (point) 1))
    (should-error (insert "X") :type 'text-read-only)))

(ert-deftest semacs-field-multiline-prefix-and-input ()
  (semacs-with-field-reference "提示\n中: " "abc\ndef"
    (move-beginning-of-line 1)
    (should (= (point) 11))
    (goto-char 10)
    (move-beginning-of-line 1)
    (should (= (point) 7))
    (move-end-of-line 1)
    (should (= (point) 10))
    (goto-char 4)
    (move-end-of-line 1)
    (should (= (point) 10))
    (goto-char 6)
    (move-beginning-of-line 1)
    (should (= (point) 4))))

(ert-deftest semacs-field-prefix-end-is-editable-but-crossing-is-not ()
  (semacs-with-field-reference "中: " "abc"
    (goto-char 4)
    (should-error (delete-backward-char 1) :type 'text-read-only)
    (insert "字")
    (should (equal (buffer-string) "中: 字abc"))
    (should-error (delete-region 2 5) :type 'text-read-only)
    (should (equal (buffer-string) "中: 字abc"))))

(ert-deftest semacs-field-readonly-kill-copies-only-prompt-field ()
  (semacs-with-field-reference "Input: " "abc"
    (goto-char 1)
    (setq this-command 'kill-line)
    (should-error (kill-line) :type 'text-read-only)
    (should (= (point) 8))
    (should (equal kill-ring '("Input: ")))
    (should (equal (buffer-string) "Input: abc"))
    (setq last-command this-command this-command 'kill-line)
    (kill-line)
    (should (equal (buffer-string) "Input: "))
    (should (equal kill-ring '("Input: abc")))))

(ert-deftest semacs-field-copy-region-may-include-readonly-text ()
  (semacs-with-field-reference "P: " "abc"
    (goto-char 2)
    (set-mark (point))
    (goto-char 6)
    (kill-ring-save (region-beginning) (region-end))
    (should (equal kill-ring '(": ab")))
    (should (equal (buffer-string) "P: abc"))))

(ert-deftest semacs-field-yank-mark-before-protected-text-error ()
  (dolist (entries '(("X") ("") nil))
    (semacs-with-field-reference "P: " "abc"
      (setq kill-ring entries kill-ring-yank-pointer kill-ring)
      (set-mark 6)
      (deactivate-mark)
      (goto-char 2)
      (cond
       ((equal entries '("X"))
        (should-error (call-interactively #'yank) :type 'text-read-only))
       ((equal entries '(""))
        (call-interactively #'yank))
       (t (should-error (call-interactively #'yank))))
      (should (= (mark) 2))
      (should (= (point) 2))
      (should (equal (buffer-string) "P: abc")))))

(ert-deftest semacs-field-undo-does-not-remove-initialized-prompt ()
  (semacs-with-field-reference "P: " ""
    (insert "中🙂")
    (undo-boundary)
    (let ((last-command nil))
      (undo-only 1))
    (should (equal (buffer-string) "P: "))
    (should (= (point) 4))
    (should (buffer-modified-p))
    (setq last-command 'undo)
    (undo-redo 1)
    (should (equal (buffer-string) "P: 中🙂"))
    (should (= (point) 4))))
